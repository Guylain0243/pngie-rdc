  const provCode='RDC-'+prov.slice(0,2).toUpperCase();
  return Array.from({length:nT}).map((_,i)=>{
    const tName=`Territoire de ${prov.split(' ')[0]}${i+1}`;
    const tCode=`${provCode}-T${String(i+1).padStart(2,'0')}`;
    const nC=2+((i*3)%3);

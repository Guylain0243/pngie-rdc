// IA CHAT (espace personnel)
// ════════════════════════════════════════════════
function addMsg(id,who,text){
  const el=document.getElementById('chat-'+id);
  const d=document.createElement('div');d.className='ia-msg '+who;d.textContent=text;
  el.appendChild(d);el.scrollTop=el.scrollHeight;
}
function initChat(id,greet){ document.getElementById('chat-'+id).innerHTML='';addMsg(id,'bot',greet); }
function sendMsg(id){
  const inp=document.getElementById('inp-'+id); const v=inp.value.trim(); if(!v)return;
  addMsg(id,'user',v); inp.value='';
  setTimeout(()=>addMsg(id,'bot','Analyse effectuée. Voici un résumé synthétique basé sur les données disponibles pour : « '+v+' ».'),700);
}


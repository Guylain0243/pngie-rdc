// BARRE D'ETAT — horloge et fuseau reels (navigateur), statut de connexion reel.
// IP publique / latence / disponibilite serveur : necessitent une route backend
// dediee qui n'existe pas encore -> affiches "non disponible", jamais invente.
// ════════════════════════════════════════════════
function updateStatusBar(){
  const now=new Date();
  const dateEl=document.getElementById('sbDate'), timeEl=document.getElementById('sbTime'), tzEl=document.getElementById('sbTimezone');
  if(!dateEl) return; // barre pas encore dans le DOM (avant login)
  dateEl.textContent=now.toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit',year:'numeric'});
  timeEl.textContent=now.toLocaleTimeString('fr-FR');
  const offsetH=-now.getTimezoneOffset()/60;
  const tzName=Intl.DateTimeFormat().resolvedOptions().timeZone||'';
  tzEl.textContent=`UTC${offsetH>=0?'+':''}${offsetH} (${tzName})`;
}
function updateOnlineStatus(){
  const el=document.getElementById('sbOnline');
  if(!el) return;
  const online=navigator.onLine;
  el.innerHTML = online
    ? `<i class="ti ti-plug-connected"></i><span>Connecté</span>`
    : `<i class="ti ti-plug-connected-x"></i><span>Hors ligne</span>`;
  el.classList.toggle('sb-online',online);
  el.classList.toggle('sb-offline',!online);
}
window.addEventListener('online',updateOnlineStatus);
window.addEventListener('offline',updateOnlineStatus);
setInterval(updateStatusBar,1000);
updateStatusBar();
updateOnlineStatus();

fillLoginSelect();
renderLoginLog();

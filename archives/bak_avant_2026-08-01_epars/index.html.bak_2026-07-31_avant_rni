const API_BASE='';
let authToken=null;
let REAL_GROUPS={};

async function apiGet(path){
  const resp=await fetch(`${API_BASE}${path}`,{headers:{Authorization:`Bearer ${authToken}`}});
  const data=await resp.json().catch(()=>({}));
  if(!resp.ok){ const e=new Error(data.error||'Erreur serveur'); e.status=resp.status; throw e; }
  return data;
}
// Charge la vraie liste des institutions, regroupees par type_institution cote serveur.
async function loadRealInstitutions(){
  try{
    const resp=await fetch(`${API_BASE}/api/public/institutions`);
    if(!resp.ok) throw new Error('http '+resp.status);
    REAL_GROUPS=await resp.json();
  }catch(e){
    REAL_GROUPS={};
    toast('Serveur injoignable — impossible de charger les institutions réelles','er');
  }
}
function groupFor(...types){
  const out=[];
  Object.keys(REAL_GROUPS).forEach(t=>{ if(types.includes(t)) (REAL_GROUPS[t]||[]).forEach(i=>out.push(i)); });
  return out;
}
function groupForOther(excludedTypes){
  const out=[];
  Object.keys(REAL_GROUPS).forEach(t=>{ if(!excludedTypes.includes(t)) (REAL_GROUPS[t]||[]).forEach(i=>out.push(Object.assign({},i,{_type:t}))); });
  return out;
}


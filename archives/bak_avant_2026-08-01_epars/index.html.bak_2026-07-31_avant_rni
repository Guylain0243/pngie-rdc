async function login(){
  const email=document.getElementById('lu').value.trim();
  const password=document.getElementById('lp').value;
  const btn=document.querySelector('.login-btn');
  const orig=btn.textContent; btn.textContent='Connexion…'; btn.disabled=true;

  let resp,data;
  try{
    resp=await fetch(`${API_BASE}/api/auth/login`,{
      method:'POST', headers:{'Content-Type':'application/json'},
      body:JSON.stringify({email,password})
    });
    data=await resp.json();
  }catch(e){
    btn.textContent=orig; btn.disabled=false;
    toast('Serveur injoignable — vérifiez que le backend tourne (node src\\server.js)','er');
    return;
  }
  btn.textContent=orig; btn.disabled=false;
  if(!resp.ok){ toast(data.error||'Connexion refusée','er'); return; }

  authToken=data.token;
  const person=data.person||{}; const roles=data.roles||[];
  CUR.role = roles[0] ? (roles[0].nom||roles[0].code) : 'Agent';
  CUR.code = roles[0] ? (roles[0].code||'AG') : 'AG';
  CUR.inst = person.email||email;
  CUR.restricted=false;
  CUR.personId = person.personne_id || null;

  document.getElementById('loginScreen').style.display='none';
  document.getElementById('mainApp').style.display='grid';
  document.getElementById('tbAv').textContent=CUR.code;
  document.getElementById('tbNm').textContent=`${person.prenom||''} ${person.nom||''}`.trim()||CUR.role;
  document.getElementById('tbInstLbl').textContent=email;

  await loadRealInstitutions();
  buildSidebar();
  await buildAll();
  toast('Connexion sécurisée établie — bienvenue '+CUR.role,'ok');
}
function logout(){
  authToken=null; REAL_GROUPS={};
  document.getElementById('mainApp').style.display='none';
  document.getElementById('loginScreen').style.display='flex';
  document.getElementById('lp').value='';
}


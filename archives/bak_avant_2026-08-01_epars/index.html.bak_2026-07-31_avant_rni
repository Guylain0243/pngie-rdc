<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PNGIE-RDC — Plateforme Nationale de Gouvernance Intégrée</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  /* Couleurs du drapeau de la RDC */
  --blue:#003DA5;--blue2:#0057C2;--blue3:#001E52;--sky:#3E9AE8;
  --yellow:#FFD100;--yellow2:#FFE066;--yellow3:#B38F00;
  --red:#CE1126;--red2:#E8384F;
  --cream:#F7F6F0;--w:#fff;--text:#132043;--muted:#525C74;--light:#F1F1EC;--border:rgba(0,0,0,0.09);
  --green:#1A7A3C;--amber:#B45309;--purple:#6B21A8;
}
body{font-family:'Source Sans 3',sans-serif;background:var(--cream);color:var(--text)}
.app{display:grid;grid-template-rows:54px 1fr 26px;height:100vh;overflow:hidden}
.statusbar{background:var(--blue3);border-top:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;gap:16px;padding:0 14px;font-size:10px;color:rgba(255,255,255,0.55);overflow-x:auto;white-space:nowrap}
.sb-stat{display:flex;align-items:center;gap:5px}
.sb-stat i{font-size:12px}
.sb-spacer{flex:1}
.sb-online{color:var(--green) !important}
.sb-offline{color:var(--red) !important}

/* DRAPEAU MINI (logo) */
.flag{position:relative;overflow:hidden;background:var(--blue);flex-shrink:0}
.flag::before{content:'';position:absolute;left:-15%;top:38%;width:135%;height:26%;background:var(--yellow);transform:rotate(-32deg)}
.flag::after{content:'';position:absolute;left:-15%;top:44%;width:135%;height:14%;background:var(--red);transform:rotate(-32deg)}
.flag .star{position:absolute;left:14%;top:14%;color:var(--yellow);font-size:.9em;z-index:2;text-shadow:0 0 2px rgba(0,0,0,.3)}
.flag-emblem{width:34px;height:34px;border-radius:9px;border:1.5px solid var(--yellow)}
.flag-emblem .star{font-size:12px}
.flag-big{width:64px;height:64px;border-radius:14px;border:2px solid var(--yellow);margin:0 auto 10px}
.flag-big .star{font-size:20px}

.topbar{background:var(--blue3);display:flex;align-items:center;padding:0 14px;border-bottom:2px solid var(--yellow)}
.tb-logo{display:flex;align-items:center;gap:9px;padding-right:16px;border-right:1px solid rgba(255,255,255,0.12)}
.tb-name{font-family:'Cinzel',serif;color:var(--yellow);font-size:13px;font-weight:600}
.tb-sub{color:rgba(255,255,255,0.4);font-size:9px}
.tb-nav{display:flex;gap:1px;padding:0 10px;flex:1;overflow-x:auto}
.tb-btn{background:none;border:none;color:rgba(255,255,255,0.6);font-size:11px;font-family:'Source Sans 3',sans-serif;padding:5px 9px;border-radius:5px;cursor:pointer;transition:all .2s;white-space:nowrap}
.tb-btn:hover,.tb-btn.act{background:rgba(255,209,0,0.15);color:var(--yellow)}
.tb-right{display:flex;align-items:center;gap:8px;padding-left:10px;border-left:1px solid rgba(255,255,255,0.12)}
.tb-avatar{width:26px;height:26px;border-radius:50%;background:var(--yellow);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:var(--blue3)}
.tb-uname{color:rgba(255,255,255,0.7);font-size:11px}
.tb-inst{color:rgba(255,255,255,0.4);font-size:9px}
.tb-badge{background:var(--red);color:#fff;font-size:9px;padding:1px 6px;border-radius:20px;font-weight:700}
.tb-logout{background:none;border:1px solid rgba(255,255,255,0.18);color:rgba(255,255,255,0.55);font-size:11px;padding:4px 8px;border-radius:5px;cursor:pointer}

.body{display:grid;grid-template-columns:216px 1fr;height:calc(100vh - 54px);overflow:hidden}
.sidebar{background:var(--blue3);overflow-y:auto;border-right:1px solid rgba(255,255,255,0.06);display:flex;flex-direction:column}
.sb-section{padding:10px 8px 3px}
.sb-label{font-size:9px;letter-spacing:.12em;color:rgba(255,255,255,0.3);padding:0 8px;text-transform:uppercase;font-weight:600}
.sb-item{display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:7px;cursor:pointer;transition:all .2s;color:rgba(255,255,255,0.6);font-size:11.5px;margin:1px 0}
.sb-item:hover{background:rgba(255,255,255,0.07);color:#fff}
.sb-item.act{background:rgba(255,209,0,0.16);color:var(--yellow)}
.sb-item i{font-size:15px;width:17px;text-align:center}
.sb-badge{margin-left:auto;background:var(--red);color:#fff;font-size:8px;padding:1px 5px;border-radius:20px;font-weight:700}
.sb-divider{height:1px;background:rgba(255,255,255,0.06);margin:6px 10px}
.sb-bottom{margin-top:auto;padding:10px;border-top:1px solid rgba(255,255,255,0.06)}
.sb-info{font-size:9.5px;color:rgba(255,255,255,0.25);padding:4px 8px;line-height:1.6}
.main{overflow-y:auto;background:var(--cream)}
.page{display:none;padding:20px 24px;animation:fadeIn .22s ease}
.page.act{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
.ph{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:10px}
.ph-title{font-family:'Cinzel',serif;font-size:18px;font-weight:600;color:var(--blue)}
.ph-sub{font-size:11.5px;color:var(--muted);margin-top:2px}
.ph-actions{display:flex;gap:7px;flex-wrap:wrap}
.btn{padding:7px 14px;border-radius:7px;border:1px solid var(--border);background:#fff;color:var(--text);font-size:11.5px;font-family:'Source Sans 3',sans-serif;cursor:pointer;font-weight:500;transition:all .17s;display:inline-flex;align-items:center;gap:5px}
.btn:hover{border-color:var(--blue2);color:var(--blue2)}
.btn.primary{background:var(--blue);color:var(--yellow);border-color:var(--blue)}
.btn.primary:hover{background:var(--blue2);color:#fff}
.btn.success{background:var(--green);color:#fff;border-color:var(--green)}
.btn.danger{background:var(--red);color:#fff;border-color:var(--red)}
.btn.sm{padding:4px 9px;font-size:10.5px}
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.kpi{background:#fff;border:0.5px solid var(--border);border-radius:11px;padding:14px;position:relative;overflow:hidden}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--kc,var(--yellow))}
.kpi-lbl{font-size:10.5px;color:var(--muted);margin-bottom:5px}
.kpi-val{font-size:23px;font-weight:700;color:var(--blue);font-family:'Cinzel',serif;line-height:1}
.kpi-tr{font-size:10.5px;margin-top:4px;font-weight:500}
.tup{color:var(--green)}.tdn{color:var(--red)}.twn{color:var(--amber)}
.card{background:#fff;border:0.5px solid var(--border);border-radius:11px;padding:18px;margin-bottom:14px}
.card-title{font-size:13px;font-weight:600;color:var(--blue);margin-bottom:12px;display:flex;align-items:center;gap:7px}
.card-title i{font-size:15px;color:var(--yellow3)}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:11.5px}
thead th{background:var(--blue);color:rgba(255,255,255,0.85);padding:9px 11px;text-align:left;font-weight:500;font-size:10.5px}
tbody tr{border-bottom:.5px solid var(--border);transition:background .12s}
tbody tr:hover{background:var(--cream)}
tbody td{padding:8px 11px;vertical-align:middle}
.badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:20px;font-size:9.5px;font-weight:700}
.bg{background:#DCFCE7;color:#166534}.br{background:#FEE2E2;color:#991B1B}
.ba{background:#FEF3C7;color:#92400E}.bb{background:#DBEAFE;color:#1E40AF}
.bn{background:#FFF6D6;color:#7A5E00}.bp{background:#F3E8FF;color:#6B21A8}
.sr{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:.5px solid var(--border)}
.sr:last-child{border:none}
.sr-n{font-size:11.5px;color:var(--text)}.sr-v{font-size:12px;font-weight:600;color:var(--blue)}
.prog{margin-bottom:10px}
.prog-hdr{display:flex;justify-content:space-between;margin-bottom:4px;font-size:11px}
.prog-tr{height:6px;background:var(--light);border-radius:10px;overflow:hidden}
.prog-fl{height:100%;border-radius:10px}
.alert{display:flex;align-items:flex-start;gap:10px;padding:10px 12px;border-radius:8px;margin-bottom:8px;border:.5px solid transparent}
.a-cr{background:#FEE2E2;border-color:#FCA5A5}.a-wn{background:#FEF3C7;border-color:#FCD34D}
.a-in{background:#DBEAFE;border-color:#93C5FD}.a-ok{background:#DCFCE7;border-color:#86EFAC}
.alert-icon{font-size:16px;flex-shrink:0}
.alert-body{flex:1}
.alert-title{font-size:11.5px;font-weight:600;color:var(--blue);margin-bottom:2px}
.alert-desc{font-size:10.5px;color:var(--muted)}
.alert-time{font-size:9.5px;color:var(--muted);flex-shrink:0}
.ia-wrap{border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-top:4px}
.ia-msgs{height:190px;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;background:var(--light)}
.ia-msg{max-width:85%;padding:8px 12px;border-radius:10px;font-size:11.5px;line-height:1.5;white-space:pre-line}
.ia-msg.bot{background:var(--blue);color:rgba(255,255,255,0.9);align-self:flex-start}
.ia-msg.user{background:var(--yellow);color:var(--blue3);align-self:flex-end;font-weight:500}
.ia-input-row{display:flex;gap:8px;padding:10px;background:#fff;border-top:1px solid var(--border)}
.ia-input-row input{flex:1;border:.5px solid var(--border);border-radius:6px;padding:7px 11px;font-size:11.5px;font-family:'Source Sans 3',sans-serif;outline:none}
.ia-input-row input:focus{border-color:var(--blue2)}
.mb{display:none;position:fixed;inset:0;background:rgba(0,20,60,0.65);align-items:center;justify-content:center;z-index:1000;padding:20px}
.mb.open{display:flex}
.modal{background:#fff;border-radius:13px;width:100%;max-width:540px;overflow:hidden;max-height:90vh;overflow-y:auto}
.modal-hdr{background:var(--blue);padding:14px 18px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0}
.modal-hdr-title{font-family:'Cinzel',serif;color:var(--yellow);font-size:14px;font-weight:600}
.modal-close{background:none;border:none;color:rgba(255,255,255,0.5);font-size:18px;cursor:pointer}
.modal-body{padding:18px}
.modal-footer{padding:12px 18px;border-top:.5px solid var(--border);display:flex;justify-content:flex-end;gap:8px}
.fg{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.ff{display:flex;flex-direction:column;gap:3px}
.ff label{font-size:10.5px;color:var(--muted);font-weight:500}
.ff input,.ff select,.ff textarea{border:.5px solid var(--border);border-radius:6px;padding:8px 11px;font-size:11.5px;font-family:'Source Sans 3',sans-serif;background:#fff;color:var(--text);outline:none}
.ff input:focus,.ff select:focus{border-color:var(--blue2)}
.ff.full{grid-column:1/-1}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--blue3);color:#fff;padding:10px 20px;border-radius:8px;font-size:12px;z-index:2000;display:none;border-left:4px solid var(--yellow);min-width:260px}
.toast.show{display:block}
.toast.ok{border-color:var(--green)}.toast.err{border-color:var(--red)}

/* LOGIN */
#loginScreen{display:flex;min-height:100vh;background:linear-gradient(160deg,var(--blue3),var(--blue));align-items:center;justify-content:center;padding:20px}
.login-box{background:rgba(255,255,255,0.06);border:1px solid rgba(255,209,0,0.3);border-radius:15px;padding:32px;width:100%;max-width:380px;backdrop-filter:blur(2px)}
.login-title{font-family:'Cinzel',serif;color:var(--yellow);font-size:20px;font-weight:600;text-align:center}
.login-sub{color:rgba(255,255,255,0.4);font-size:10px;text-align:center;margin-top:3px;margin-bottom:18px}
.login-field{margin-bottom:11px}
.login-field label{display:block;font-size:10.5px;color:rgba(255,255,255,0.5);margin-bottom:4px}
.login-field input,.login-field select{width:100%;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:7px;padding:9px 12px;color:#fff;font-size:12.5px;font-family:'Source Sans 3',sans-serif;outline:none}
.login-field select option{color:#111}
.role-chips{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-bottom:14px}
.rc{padding:7px 5px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:7px;text-align:center;cursor:pointer;transition:all .18s}
.rc:hover,.rc.sel{background:rgba(255,209,0,0.16);border-color:var(--yellow3)}
.rc-name{font-size:9.5px;color:#fff;font-weight:600}
.rc-sub{font-size:8px;color:rgba(255,255,255,0.4);margin-top:1px}
.otp-row{display:flex;gap:6px}
.otp-row input{width:38px;text-align:center;font-size:16px;letter-spacing:0}
.bio-box{border:1.5px dashed var(--yellow3);border-radius:9px;padding:12px;text-align:center;margin-bottom:12px;cursor:pointer;transition:all .2s}
.bio-box:hover{border-color:var(--yellow)}
.bio-box i{font-size:22px;color:var(--yellow);display:block;margin-bottom:4px}
.bio-box span{font-size:9.5px;color:rgba(255,255,255,0.5)}
.login-btn{width:100%;background:var(--yellow);color:var(--blue3);border:none;border-radius:7px;padding:11px;font-size:13px;font-weight:700;font-family:'Cinzel',serif;cursor:pointer;margin-top:4px;letter-spacing:.04em}
.login-btn:hover{background:var(--yellow2)}
.login-log{background:rgba(0,0,0,0.2);border-radius:7px;padding:8px 10px;margin-top:14px;max-height:70px;overflow-y:auto}
.j-line{padding:2px 0;font-family:monospace;font-size:9px;color:rgba(255,255,255,0.5);line-height:1.7}

/* Cartes institutions/ministères */
.ent-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px}
.ent-card{background:#fff;border:.5px solid var(--border);border-radius:10px;padding:12px 13px;cursor:pointer;transition:all .17s;position:relative}
.ent-card:hover{border-color:var(--blue2);transform:translateY(-1px);box-shadow:0 4px 14px rgba(0,61,165,.08)}
.ent-card::before{content:'';position:absolute;left:0;top:10px;bottom:10px;width:3px;border-radius:3px;background:var(--yellow)}
.ent-ico{width:30px;height:30px;border-radius:8px;background:var(--cream);display:flex;align-items:center;justify-content:center;color:var(--blue);font-size:15px;margin-bottom:8px}
.ent-name{font-size:11.5px;font-weight:600;color:var(--text);line-height:1.3}
.ent-tag{font-size:9px;color:var(--muted);margin-top:3px}

/* Organigramme arbre */
.tree{list-style:none}
.tree .node{background:var(--blue);color:#fff;padding:8px 12px;border-radius:8px;display:inline-block;font-size:11.5px;font-weight:600;margin-bottom:6px;border-left:3px solid var(--yellow)}
.tree ul{list-style:none;margin-left:16px;padding-left:16px;border-left:1.5px dashed var(--border)}
.tree li{position:relative;padding:5px 0}
.tree li::before{content:'';position:absolute;left:-16px;top:16px;width:14px;border-top:1.5px dashed var(--border)}
.tree .leaf{background:#fff;border:.5px solid var(--border);padding:5px 11px;border-radius:7px;font-size:11px;display:inline-block;color:var(--text)}
.tree .leaf i{color:var(--blue2);margin-right:5px}

/* Tabs portail */
.tabs{display:flex;gap:2px;border-bottom:1.5px solid var(--border);margin-bottom:14px;overflow-x:auto}
.tab{padding:8px 14px;font-size:11.5px;font-weight:500;color:var(--muted);cursor:pointer;border-bottom:2.5px solid transparent;white-space:nowrap}
.tab.act{color:var(--blue);border-color:var(--yellow)}
.tabpage{display:none}
.tabpage.act{display:block}

/* Espace personnel */
.wgrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}
.tasklist{display:flex;flex-direction:column;gap:7px}
.task{display:flex;align-items:center;gap:8px;padding:7px 9px;border-radius:7px;background:var(--cream);font-size:11.5px}
.task input{accent-color:var(--blue)}
.task.done{opacity:.5;text-decoration:line-through}

/* Messagerie */
.mail-list{display:flex;flex-direction:column}
.mail-row{display:flex;gap:10px;padding:10px 8px;border-bottom:.5px solid var(--border);cursor:pointer;align-items:flex-start}
.mail-row:hover{background:var(--cream)}
.mail-row.unread .mail-subj{font-weight:700}
.mail-av{width:28px;height:28px;border-radius:50%;background:var(--blue);color:var(--yellow);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0}
.mail-body{flex:1;min-width:0}
.mail-from{font-size:11px;font-weight:600;color:var(--text)}
.mail-subj{font-size:11px;color:var(--text);margin-top:1px}
.mail-prev{font-size:10.5px;color:var(--muted);margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mail-time{font-size:9.5px;color:var(--muted);flex-shrink:0}

/* RBAC */
.rbac-tbl th,.rbac-tbl td{text-align:center}
.rbac-tbl td:first-child,.rbac-tbl th:first-child{text-align:left}
.chk{color:var(--green);font-size:14px}
.crx{color:rgba(0,0,0,0.12);font-size:14px}

.pill{display:inline-block;padding:3px 10px;border-radius:20px;font-size:9.5px;font-weight:700;background:var(--cream);color:var(--blue)}
.avatar-lg{width:52px;height:52px;border-radius:12px;background:var(--blue);color:var(--yellow);display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700}
</style>
</head>
<body>

<!-- ═══════════════ ÉCRAN DE CONNEXION SÉCURISÉ ═══════════════ -->
<div id="loginScreen">
  <div class="login-box">
    <div class="flag-big" style="position:relative"><span class="star">★</span></div>
    <div class="login-title">PNGIE-RDC</div>
    <div class="login-sub">Plateforme Nationale de Gouvernance Intégrée<br>République Démocratique du Congo</div>

    <div class="login-field">
      <label>Choix de l'institution</label>
      <select id="lInst" onchange="onInstChange(this.value)"></select>
    </div>
    <div class="login-field"><label>Identifiant (ID)</label><input id="lu" value="admin.presidence@pngie-rdc.gov.cd"></div>
    <div class="login-field"><label>Mot de passe</label><input type="password" id="lp" value="••••••••"></div>

    <div id="otpBlock" style="display:none">
      <div class="login-field">
        <label>Authentification à deux facteurs — Code OTP envoyé par SMS</label>
        <div class="otp-row">
          <input maxlength="1" class="login-field-otp"><input maxlength="1"><input maxlength="1"><input maxlength="1"><input maxlength="1"><input maxlength="1">
        </div>
      </div>
    </div>
    <button class="btn sm" style="width:100%;margin-bottom:10px;justify-content:center;background:rgba(255,255,255,0.08);color:#fff;border-color:rgba(255,255,255,0.15)" onclick="sendOtp()">Envoyer le code OTP</button>

    <div class="bio-box" id="bioBox" onclick="scanBioLogin()">
      <i class="ti ti-fingerprint"></i>
      <span id="bioTxt">Vérification biométrique (empreinte / reconnaissance faciale)</span>
    </div>

    <button class="login-btn" onclick="login()">ACCÈS SÉCURISÉ →</button>

    <div class="login-log" id="loginLog"></div>
    <div style="font-size:8px;color:rgba(255,255,255,0.18);text-align:center;margin-top:12px">CONFIDENTIEL — Présidence de la République Démocratique du Congo<br>PNGIE-RDC — Journal de connexion horodaté et chiffré (AES-256)</div>
  </div>
</div>

<!-- ═══════════════ APPLICATION PRINCIPALE ═══════════════ -->
<div class="app" id="mainApp" style="display:none">
  <div class="topbar">
    <div class="tb-logo">
      <div class="flag flag-emblem" style="position:relative"><span class="star">★</span></div>
      <div><div class="tb-name">PNGIE-RDC</div><div class="tb-sub">Gouvernance Numérique Nationale</div></div>
    </div>
    <div class="tb-nav" id="tbNav">
      <button class="tb-btn act" onclick="nav(this,'dashboard')"><i class="ti ti-layout-dashboard"></i> Cockpit</button>
      <button class="tb-btn" onclick="nav(this,'institutions')"><i class="ti ti-building-bank"></i> Institutions</button>
      <button class="tb-btn" onclick="nav(this,'ministeres')"><i class="ti ti-building-castle"></i> Ministères</button>

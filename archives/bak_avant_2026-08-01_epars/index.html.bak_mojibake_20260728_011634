function normFR(s){ return (s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,''); }
async function loadRealMinisteres(){
  try {
    const rows = await apiGet('/api/ministeres');
    liveMinisteres = rows.map(r=>{
      const rNorm = normFR(r.nom); let local = MINISTERES.find(m => normFR(m.nom) === rNorm); if (!local) { local = MINISTERES.find(m => normFR(m.nom).includes(rNorm) || rNorm.includes(normFR(m.nom))); }
      return { nom:r.nom, type: local ? local.type : (normFR(r.type).includes('regal') ? 'rÃ©galien':'sectoriel'),
        taches: local ? local.taches : [r.description || 'Portefeuille enregistrÃ© dans la base â€” description Ã  complÃ©ter'] };
    });
    ministeresSource = 'live';
  } catch(e){
    liveMinisteres = null;
    ministeresSource = e.status===403 ? 'refuse' : 'hors-ligne';
  }
  renderMinisteres();
}

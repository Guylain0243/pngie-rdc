const chatH={};

async function callClaude(dept,msg){
  if(dept==='ia'){
    if(!selectedAgentId){ return 'Veuillez d\'abord selectionner un agent IA dans la liste ci-dessus.'; }
    try{
      const resp=await fetch(`/api/agents/${selectedAgentId}/chat`,{
        method:'POST',
        headers:{'Content-Type':'application/json','Authorization':`Bearer ${authToken}`},
        body:JSON.stringify({message:msg})
      });
      const data=await resp.json();
      if(!resp.ok||data.ok===false) return data.error||'Erreur agent IA.';
      return data.reply||'Pas de reponse.';
    }catch(e){ return 'Erreur de connexion au serveur PNGIE-RDC.'; }
  }
  if(!chatH[dept])chatH[dept]=[];
  chatH[dept].push({role:'user',content:msg});
  try{
    const r=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:1000,system:SYS[dept]||SYS.ia,messages:chatH[dept]})
    });
    const d=await r.json();
    const rep=d.content?.[0]?.text||'Erreur API.';
    chatH[dept].push({role:'assistant',content:rep});
    return rep;
  }catch(e){return 'Erreur de connexion a l API Claude.';}
}
function addMsg(id,role,txt){
  const el=document.getElementById('chat-'+id);
  if(!el)return null;
  const d=document.createElement('div');
  d.className='ia-msg '+role;d.textContent=txt;
  el.appendChild(d);el.scrollTop=el.scrollHeight;return d;
}

async function sendMsg(dept){
  const inp=document.getElementById('inp-'+dept);
  if(!inp||!inp.value.trim())return;
  const msg=inp.value.trim();inp.value='';
  addMsg(dept,'user',msg);
  const t=addMsg(dept,'typing','âŸ³ Analyse en coursâ€¦');
  const r=await callClaude(dept,msg);
  t&&t.remove();addMsg(dept,'bot',r);
}


async function login(){
  const mfaErr = document.getElementById('mfaError');
  mfaErr.style.display = 'none';
  const mfaCode = document.getElementById('mfaCode').value.trim();
  if(!/^\d{6}$/.test(mfaCode)){
    mfaErr.style.display='block';
    mfaErr.textContent='Entrez un code Ã  6 chiffres (dÃ©monstration : n\'importe lequel).';
    return;
  }
  const email = document.getElementById('lu').value.trim();
  const password = document.getElementById('lp').value;
  const btn = document.querySelector('#loginStep2 .login-btn');
  const origLabel = btn.textContent;
  btn.textContent = 'Validationâ€¦';
  btn.disabled = true;

  let resp, data;
  try {
    resp = await fetch(`${API_BASE}/api/auth/login`, {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({email, password})
    });
    data = await resp.json();
  } catch(e) {
    btn.textContent = origLabel; btn.disabled = false;
    mfaErr.style.display = 'block';
    mfaErr.innerHTML = `Serveur injoignable sur <code>${API_BASE}</code>.<br>VÃ©rifie que le service tourne, puis rÃ©essaie.`;
    return;
  }
  btn.textContent = origLabel; btn.disabled = false;

  if (!resp.ok) {
    mfaErr.style.display = 'block';
    mfaErr.textContent = data.error || 'Connexion refusÃ©e.';
    return;
  }

  authToken = data.token;

  // RÃ©cupÃ¨re le pÃ©rimÃ¨tre RÃ‰EL de pages autorisÃ©es (RBAC calculÃ© cÃ´tÃ© serveur, pas la config locale)
  try {
    const meResp = await fetch(`${API_BASE}/api/me`, {headers:{Authorization:`Bearer ${authToken}`}});
    const me = await meResp.json();
    realPages = me.pages || null;
  } catch(e) { realPages = null; }

  // Chargement automatique du poste rÃ©el (institution > unitÃ© > fonction > permissions) â€” pas de second mot de passe
  bureauNumerique = null;
  try {
    const posteResp = await fetch(`${API_BASE}/api/me/poste`, {headers:{Authorization:`Bearer ${authToken}`}});
    if(posteResp.ok) bureauNumerique = await posteResp.json();
  } catch(e) { bureauNumerique = null; }

  // Le rÃ´le/tableau de bord visuel se dÃ©duit du VRAI poste chargÃ© automatiquement, prioritaire sur le choix fait Ã  l'Ã©tape 1
  if(bureauNumerique && bureauNumerique.type_institution){
